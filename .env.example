# Copy this file to .env and fill in real values.
# Never commit .env.
#
# Chỉ cần điền key của MỘT provider — cái bạn định chạy.
#   Gemini (mặc định) : npm run dev          → cần GEMINI_API_KEY
#   Claude            : npm run dev:claude   → cần ANTHROPIC_API_KEY
# Chạy provider nào thì server chỉ đòi key của provider đó, không đòi cái còn lại.

# --- Gemini (mặc định — teammate không đổi gì thì chạy nhánh này) ---
# Key lấy ở https://aistudio.google.com/apikey — key hợp lệ bắt đầu bằng "AIza".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Claude (chỉ cần khi chạy `npm run dev:claude`) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Chọn provider mặc định mà không cần gõ cờ --claude mỗi lần: gemini | claude
# Cờ --claude / --gemini trên dòng lệnh luôn thắng biến này.
AI_PROVIDER=gemini

# Local app defaults.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
