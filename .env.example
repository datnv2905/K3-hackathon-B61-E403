# Copy this file to .env and fill in real values.
# Never commit .env.

# Required for the real AI tutor / quiz generation call.
GEMINI_API_KEY=

# Keep configurable so the demo can switch models without code changes.
GEMINI_MODEL=gemini-3.6-flash

# Local app defaults.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
